{
  "name": "celestial-geometry-framework",
  "version": "0.1.0",
  "description": "A kit for interactive celestial/geometric canvas figures: pan/zoom camera, angle constructions, collision-avoiding label layout, and hover-to-explain diagrams.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./canvas-diagram/index.ts",
    "./scene": "./canvas-diagram/scene/index.ts",
    "./three": "./canvas-diagram/three/index.ts",
    "./editor": "./canvas-diagram/editor/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/test/*.test.js\"",
    "emit-check": "tsc -p tsconfig.test.json && node test/emit-check.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "three": "^0.186.0",
    "typescript": "^5.7"
  }
}
